#include <iostream>

using namespace std;

// Declaración de prototipos de funciones
void menu();
void primerapregunta(int edad, int nota);
int precios(int peso);
float totalapagar(int cantidad, float precio);

int main()
{
    int opcion;
    do {
        menu();
        cin >> opcion;

        switch (opcion)
        {
        case 1: {
            int edad, nota;
            cout << "\n--- PREGUNTA 1 ---\n";
            cout << "Ingrese la edad: ";
            cin >> edad;
            cout << "Ingrese la nota: ";
            cin >> nota;
            primerapregunta(edad, nota);
            break;
        }
        case 2: {
            int peso;
            cout << "\n--- PREGUNTA 2 (Cálculo de Envío) ---\n";
            cout << "Ingrese el peso en kg: ";
            cin >> peso;

            int costo = precios(peso);
            if (costo != -1) {
                cout << "El costo de envio es: Bs. " << costo << endl;
            }
            else {
                cout << "El paquete excede el peso permitido (maximo 10 kg).\n";
            }
            break;
        }
        case 3: {
            int cantidad;
            float precio;
            cout << "\n--- CALCULAR TOTAL A PAGAR ---\n";
            cout << "Ingrese la cantidad: ";
            cin >> cantidad;
            cout << "Ingrese el precio unitario: ";
            cin >> precio;
            cout << "El total a pagar es: " << totalapagar(cantidad, precio) << endl;
            break;
        }
        case 4:
            cout << "Saliendo del programa..." << endl;
            break;

        default:
            cout << "Opcion invalida. Intente de nuevo." << endl;
        }
        cout << endl;

    } while (opcion != 4);

    return 0;
}

