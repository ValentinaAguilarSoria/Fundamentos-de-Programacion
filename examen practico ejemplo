// Lógica de la Pregunta 2: Tarifas de envío según el peso
int precios(int peso) {
    if (peso <= 2) {
        return 15; // Hasta 2 kg -> Bs. 15
    }
    else if (peso <= 5) {
        return 25; // Más de 2 kg y hasta 5 kg -> Bs. 25
    }
    else if (peso <= 10) {
        return 40; // Más de 5 kg y hasta 10 kg -> Bs. 40
    }
    else {
        return -1; // En caso de exceder el peso máximo permitido
    }
}

