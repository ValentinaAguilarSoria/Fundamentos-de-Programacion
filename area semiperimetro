#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    float lado1, lado2, lado3;
    float semiperimetro, area;

    cout << "Ingrese el lado 1: ";
    cin >> lado1;

    cout << "Ingrese el lado 2: ";
    cin >> lado2;

    cout << "Ingrese el lado 3: ";
    cin >> lado3;

    // Calcular el semiperimetro
    semiperimetro = (lado1 + lado2 + lado3) / 2;

    // Calcular el area usando la formula de Heron
    area = sqrt(semiperimetro *
                (semiperimetro - lado1) *
                (semiperimetro - lado2) *
                (semiperimetro - lado3));

    cout << "\nEl semiperimetro es: " << semiperimetro << endl;
    cout << "El area del triangulo es: " << area << endl;

    return 0;
}
