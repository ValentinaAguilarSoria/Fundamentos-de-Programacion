#include <iostream>
using namespace std;
int main()
{
    double hamburguesa = 0, // variable subtotal
        hamburguesaconqueso =0, // variable subtotal
        papasfritas=0,  // variable subtotal
        soda=0,  // variable subtotal
        total = 0, // variable totalizadora
        cantidad, // variable apoyo
        numero,
        precio = 0,
        suma = 0;
        
    int opcion,
        canthamb=0, // variable subtotal
        canthambconq=0, // variable subtotal
        cantpapas=0, // variable subtotal
        cantsoda=0; // variable subtotal
        
    do{
        cout<<"-----Menu-----:"<<endl;
        cout<<"1-hamburguesa(3bs):"<<endl;
        cout<<"2-hamburguesaconqueso(5bs):"<<endl;
        cout<<"3-papasfritas(2bs):"<<endl;
        cout<<"4-soda(2.5bs):"<<endl;
        cout<<"0,Salir:"<<endl;
        cout<<"Seleccione un numero(1-4):"<<endl;
        cin>>opcion;
        
        if (opcion >0 && opcion <=4){ // Validacion de entradas
            cout<<"Ingresar la cantidad:";
            cin>>cantidad;
        }

        switch (opcion) {
            case 1:
                total += cantidad*3; // actualizando el total genral
                hamburguesa += cantidad * 3; // subtotal de plata en hamburguesa
                canthamb += cantidad; // cantidad de hamburguesa pedidas
                break; 

            case 2:
                total += cantidad*5; // actualizando el total genral
                hamburguesaconqueso += cantidad * 5; // subtotal de plata en hamburguesa
                canthambconq += cantidad; // cantidad de hamburguesa pedidas
                break;

            case 3:
                total += cantidad*2; // actualizando el total genral
                papasfritas += cantidad * 2; // subtotal de plata en hamburguesa
                cantpapas += cantidad; // cantidad de hamburguesa pedidas
                break;

            case 4:
                total += cantidad*2.5; // actualizando el total genral
                soda += cantidad * 2.5; // subtotal de plata en hamburguesa
                cantsoda += cantidad; // cantidad de hamburguesa pedidas
                break;

            case 0:
                cout<<"Salir:"<<endl;
                break;

            default:
                cout<<"Opcion invalida"<<endl;
                break;
        }
        
        cout<<"==========================TU PEDIDO=========================="<<endl;
        cout<<"item                             cantidad    total"<<endl;
        cout<<"Hamburguesa (3bs)                "<<canthamb<<"          "<<hamburguesa<<endl;
        cout<<"Hamburguesaconqueso (5bs)        "<<canthambconq<<"          "<<hamburguesaconqueso<<endl;
        cout<<"Papasfritas (2bs)                "<<cantpapas<<"           "<<papasfritas<<endl;
        cout<<"soda (2.5bs)                     "<<cantsoda<<"           "<<soda<<endl;
        cout<<"============================================================"<<endl;
        cout<<"Total:"<<total<<endl;
        cout<<"============================================================"<<endl;

    } while (opcion!=0);


    return 0;
}
